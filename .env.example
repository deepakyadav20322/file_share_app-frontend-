# Backend API (defaults to the Render deployment when empty)
VITE_API_URL=http://127.0.0.1:3000/api

# Which page "/" opens: "transfer" (new key/QR page, default) or "classic" (old single-link page)
VITE_DEFAULT_HOME=transfer

# Optional: shown on the Contact page as a direct mailto link
VITE_CONTACT_EMAIL=
